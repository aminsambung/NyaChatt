<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NyaChatt</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
}

body {
  background: #e5ddd5;
  min-height: 100vh;
}

.app {
  max-width: 500px;
  height: 100dvh;
  margin: auto;
  background: white;
  display: flex;
  flex-direction: column;
}

.header {
  background: #075e54;
  color: white;
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22px;
  font-weight: bold;
}

.logout {
  background: #128c7e;
  color: white;
  border: none;
  padding: 10px;
  border-radius: 8px;
}

.login-box {
  margin: auto;
  padding: 25px;
  width: 100%;
}

.login-box h1 {
  text-align: center;
  color: #075e54;
  margin-bottom: 10px;
}

.subtitle {
  text-align: center;
  color: #777;
  margin-bottom: 25px;
}

.login-box input {
  width: 100%;
  padding: 14px;
  margin-bottom: 15px;
  border: 1px solid #ccc;
  border-radius: 10px;
  font-size: 16px;
}

.primary {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 10px;
  background: #128c7e;
  color: white;
  font-size: 17px;
  margin-bottom: 12px;
}

.switch {
  text-align: center;
  margin-top: 10px;
  color: #075e54;
  cursor: pointer;
}

.error {
  color: red;
  text-align: center;
  margin: 10px 0;
}

.hidden {
  display: none !important;
}

#chatPage {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.chat-info {
  padding: 12px;
  background: #eee;
  font-size: 14px;
}

.messages {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 15px;
  background: #efe7dd;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.message {
  max-width: 80%;
  padding: 10px 12px;
  border-radius: 10px;
  background: white;
  align-self: flex-start;
  overflow-wrap: anywhere;
  box-shadow: 0 1px 2px #0002;
}

.message.mine {
  background: #d9fdd3;
  align-self: flex-end;
}

.sender {
  color: #075e54;
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 5px;
}

.message-text {
  font-size: 15px;
  white-space: pre-wrap;
}

.time {
  text-align: right;
  color: #777;
  font-size: 10px;
  margin-top: 5px;
}

.bottom {
  padding: 10px;
  background: #f0f0f0;
  display: flex;
  gap: 8px;
}

.bottom input {
  flex: 1;
  min-width: 0;
  padding: 13px;
  border: none;
  border-radius: 25px;
  outline: none;
  font-size: 16px;
}

.send {
  width: 48px;
  height: 48px;
  border: none;
  border-radius: 50%;
  background: #128c7e;
  color: white;
  font-size: 20px;
}

.status {
  text-align: center;
  color: #777;
  font-size: 13px;
  padding: 5px;
}
</style>
</head>

<body>

<div class="app">

  <!-- LOGIN -->
  <div id="authPage" class="login-box">

    <h1>NyaChatt 💬</h1>

    <p class="subtitle" id="formTitle">
      Silakan login ke akun kamu
    </p>

    <input
      type="text"
      id="name"
      placeholder="Nama kamu"
      class="hidden"
    >

    <input
      type="email"
      id="email"
      placeholder="Email"
    >

    <input
      type="password"
      id="password"
      placeholder="Kata sandi"
    >

    <p id="error" class="error"></p>

    <button id="submitBtn" class="primary">
      Login
    </button>

    <p id="switchBtn" class="switch">
      Belum punya akun? Daftar
    </p>

  </div>

  <!-- CHAT -->
  <div id="chatPage" class="hidden">

    <div class="header">
      <span>NyaChatt 💬</span>
      <button id="logoutBtn" class="logout">
        Logout
      </button>
    </div>

    <div class="chat-info">
      Chat umum · Masuk sebagai
      <b id="userName"></b>
    </div>

    <div id="status" class="status">
      Menghubungkan...
    </div>

    <div id="messages" class="messages"></div>

    <form id="messageForm" class="bottom">
      <input
        type="text"
        id="messageInput"
        placeholder="Ketik pesan..."
        maxlength="2000"
        autocomplete="off"
        required
      >

      <button type="submit" class="send">
        ➤
      </button>
    </form>

  </div>

</div>

<script type="module">

import {
  initializeApp
} from "https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
  getAuth,
  createUserWithEmailAndPassword,
  signInWithEmailAndPassword,
  onAuthStateChanged,
  signOut,
  updateProfile
} from "https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";

import {
  getFirestore,
  collection,
  addDoc,
  query,
  orderBy,
  limit,
  onSnapshot,
  serverTimestamp
} from "https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";

// KONFIGURASI FIREBASE KAMU
const firebaseConfig = {
  apiKey: "AIzaSyB-uAsXsCILD1gshsEDueU__AP15bfVjv4",
  authDomain: "nyachatt-a262c.firebaseapp.com",
  projectId: "nyachatt-a262c",
  storageBucket: "nyachatt-a262c.firebasestorage.app",
  messagingSenderId: "1081303400744",
  appId: "1:1081303400744:web:981fd5f46c53eb2dce101d"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

// ELEMEN
const authPage = document.getElementById("authPage");
const chatPage = document.getElementById("chatPage");
const nameInput = document.getElementById("name");
const emailInput = document.getElementById("email");
const passwordInput = document.getElementById("password");
const errorText = document.getElementById("error");
const submitBtn = document.getElementById("submitBtn");
const switchBtn = document.getElementById("switchBtn");
const formTitle = document.getElementById("formTitle");
const messages = document.getElementById("messages");
const messageInput = document.getElementById("messageInput");
const messageForm = document.getElementById("messageForm");
const statusText = document.getElementById("status");

let isRegister = false;
let stopMessages = null;

// LOGIN / DAFTAR
switchBtn.addEventListener("click", () => {
  isRegister = !isRegister;

  nameInput.classList.toggle("hidden", !isRegister);

  formTitle.textContent = isRegister
    ? "Buat akun NyaChatt"
    : "Silakan login ke akun kamu";

  submitBtn.textContent = isRegister
    ? "Daftar"
    : "Login";

  switchBtn.textContent = isRegister
    ? "Sudah punya akun? Login"
    : "Belum punya akun? Daftar";

  errorText.textContent = "";
});

// PROSES LOGIN DAN DAFTAR
submitBtn.addEventListener("click", async () => {
  const email = emailInput.value.trim();
  const password = passwordInput.value;
  const name = nameInput.value.trim();

  errorText.textContent = "";

  if (!email || !password) {
    errorText.textContent =
      "Email dan kata sandi wajib diisi.";
    return;
  }

  if (isRegister && !name) {
    errorText.textContent = "Nama wajib diisi.";
    return;
  }

  if (isRegister && password.length < 6) {
    errorText.textContent =
      "Kata sandi minimal 6 karakter.";
    return;
  }

  submitBtn.disabled = true;
  submitBtn.textContent = "Memproses...";

  try {
    if (isRegister) {
      const result =
        await createUserWithEmailAndPassword(
          auth,
          email,
          password
        );

      await updateProfile(result.user, {
        displayName: name
      });

    } else {
      await signInWithEmailAndPassword(
        auth,
        email,
        password
      );
    }

  } catch (error) {
    const errors = {
      "auth/email-already-in-use":
        "Email sudah terdaftar.",
      "auth/invalid-email":
        "Format email tidak valid.",
      "auth/weak-password":
        "Kata sandi terlalu lemah.",
      "auth/invalid-credential":
        "Email atau kata sandi salah.",
      "auth/network-request-failed":
        "Periksa koneksi internet."
    };

    errorText.textContent =
      errors[error.code] ||
      "Terjadi kesalahan: " + error.message;

  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent =
      isRegister ? "Daftar" : "Login";
  }
});

// STATUS LOGIN
onAuthStateChanged(auth, (user) => {
  if (user) {
    authPage.classList.add("hidden");
    chatPage.classList.remove("hidden");

    document.getElementById("userName").textContent =
      user.displayName || user.email;

    loadMessages();
  } else {
    if (stopMessages) {
      stopMessages();
      stopMessages = null;
    }

    chatPage.classList.add("hidden");
    authPage.classList.remove("hidden");
    messages.innerHTML = "";
  }
});

// AMBIL PESAN DARI FIRESTORE
function loadMessages() {
  if (stopMessages) {
    stopMessages();
  }

  statusText.textContent = "Memuat pesan...";

  const q = query(
    collection(db, "messages"),
    orderBy("createdAt", "asc"),
    limit(100)
  );

  stopMessages = onSnapshot(q, (snapshot) => {
    messages.innerHTML = "";

    snapshot.forEach((doc) => {
      const data = doc.data();
      const mine = data.uid === auth.currentUser?.uid;

      const box = document.createElement("div");
      box.className = "message" + (mine ? " mine" : "");

      const sender = document.createElement("div");
      sender.className = "sender";
      sender.textContent = mine
        ? "Kamu"
        : data.name || "Pengguna";

      const text = document.createElement("div");
      text.className = "message-text";
      text.textContent = data.text || "";

      const time = document.createElement("div");
      time.className = "time";

      if (data.createdAt) {
        time.textContent =
          data.createdAt.toDate().toLocaleTimeString(
            "id-ID",
            {
              hour: "2-digit",
              minute: "2-digit"
            }
          );
      }

      box.appendChild(sender);
      box.appendChild(text);
      box.appendChild(time);

      messages.appendChild(box);
    });

    statusText.textContent =
      snapshot.empty
        ? "Belum ada pesan. Mulai mengobrol!"
        : "";

    messages.scrollTop = messages.scrollHeight;

  }, (error) => {
    statusText.textContent =
      "Gagal memuat pesan: " + error.message;
  });
}

// KIRIM PESAN
messageForm.addEventListener("submit", async (event) => {
  event.preventDefault();

  const user = auth.currentUser;
  const text = messageInput.value.trim();

  if (!user || !text) return;

  const button = messageForm.querySelector("button");
  button.disabled = true;

  try {
    await addDoc(collection(db, "messages"), {
      uid: user.uid,
      name: user.displayName || user.email,
      text: text,
      createdAt: serverTimestamp()
    });

    messageInput.value = "";
    messageInput.focus();

  } catch (error) {
    statusText.textContent =
      "Pesan gagal dikirim: " + error.message;
  } finally {
    button.disabled = false;
  }
});

// LOGOUT
document.getElementById("logoutBtn")
  .addEventListener("click", async () => {
    await signOut(auth);
  });

</script>
</body>
</html>
